# Normalizacion de fin de linea.
# Los scripts .sh y los workflows DEBEN viajar con LF o Linux/CI los rompe.
* text=auto eol=lf

*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Los .bat/.ps1 de Windows necesitan CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binarios: no tocar
*.png   binary
*.jpg   binary
*.xpi   binary
*.zip   binary
*.ico   binary
